<colour-block id="{$BlockID}" tabindex="-1" class="default-code [ js-default-code ] {$IncludeClasses} {$ExtraClasses}">
    <section>
        <div class="default-code__wrap">
            <div class="default-code__content">
                {$Content}
            </div>
        </div>
    </section>

    {$ExtraRequirements}
</colour-block>
