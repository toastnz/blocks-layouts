{
  "name": "toastnz/blocks-layouts",
  "description": "Silverstripe content blocks module",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "silverstripe",
    "content blocks",
    "layouts",
    "modular"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Priscilla Yap",
      "homepage": "http://toast.co.nz/",
      "role": "Developer"
    },
    {
      "name": "Emmanuel Davies",
      "homepage": "http://toast.co.nz/",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "silverstripe/cms": "^6",
    "silverstripe/userforms": "^7",
    "silverstripe/linkfield": "^5.1",
    "silverstripe/blog": "^5",
    "silverstripe/taxonomy": "^4",
    "symbiote/silverstripe-gridfieldextensions": "^5",
    "bummzack/sortablefile": "^3",
    "axllent/silverstripe-form-fields": "^2.0",
    "toastnz/open-cms-preview": "^0.2.2"
  },
  "suggest": {
    "silverstripe/subsites": "Blocks list and link to pages across all subsites when installed"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Toast\\Blocks\\Tests\\": "tests/php/"
    }
  },
  "extra": {
    "expose": [
      "client/images",
      "client/dist",
      "client/fonts"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  }
}
